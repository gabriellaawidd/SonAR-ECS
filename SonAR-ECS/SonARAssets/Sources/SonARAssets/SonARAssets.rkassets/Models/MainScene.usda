#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.100.6)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["ArrowTemplate", "Hologram", "SensorContainer", "SurfacePlane"]
    def Cone "ArrowTemplate" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            float3 rotationEulerHint = (4.712389, 0, 0)
        }
    )
    {
        reorder nameChildren = ["DefaultMaterial", "Collider", "SonARAssets_WavePropertiesComponent", "SpatialAudio"]
        uniform token axis = "Y"
        double height = 0.05
        rel material:binding = </Root/Hologram> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 0.02
        quatf xformOp:orient = (0.70710677, -0.7071067, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Material "DefaultMaterial"
        {
            token outputs:mtlx:surface.connect = </Root/ArrowTemplate/DefaultMaterial/PreviewSurface.outputs:out>
            token outputs:realitykit:vertex
            token outputs:surface.connect = </Root/ArrowTemplate/DefaultMaterial/DefaultSurfaceShader.outputs:surface>
            float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (0, 110.5)

            def Shader "DefaultSurfaceShader" (
                active = false
            )
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:roughness = 0.75
                token outputs:surface
            }

            def Shader "PreviewSurface"
            {
                uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
                token outputs:out
                float2 ui:nodegraph:node:pos = (-255, 105)
            }
        }

        def RealityKitComponent "Collider"
        {
            uint group = 1
            uniform token info:id = "RealityKit.Collider"
            uint mask = 4294967295
            token type = "Default"

            def RealityKitStruct "Shape"
            {
                float3 extent = (0.04, 0.04, 0.05)
                float height = 0.05
                float radius = 0.02
                token shapeType = "Box"

                def RealityKitStruct "pose"
                {
                }
            }
        }

        def RealityKitCustomComponent "SonARAssets_WavePropertiesComponent"
        {
            uniform token info:id = "SonARAssets.WavePropertiesComponent"
        }

        def Xform "SpatialAudio"
        {
            quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            def RealityKitComponent "SpatialAudio"
            {
                uniform token info:id = "RealityKit.SpatialAudio"
            }
        }
    }

    def Material "Hologram"
    {
        token outputs:mtlx:surface.connect = </Root/Hologram/PreviewSurface.outputs:out>
        token outputs:realitykit:vertex
        float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (821.70703, 118.33203)
        int ui:nodegraph:realitykit:subgraphOutputs:stackingOrder = 167

        def Shader "PreviewSurface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            float inputs:clearcoat
            float inputs:clearcoatRoughness
            color3f inputs:diffuseColor.connect = </Root/Hologram/Multiply.outputs:out>
            color3f inputs:emissiveColor.connect = </Root/Hologram/Multiply.outputs:out>
            float inputs:ior
            float inputs:metallic
            float3 inputs:normal
            float inputs:occlusion
            float inputs:opacity
            float inputs:roughness
            token outputs:out
            float2 ui:nodegraph:node:pos = (579.95703, 118.33203)
            int ui:nodegraph:node:stackingOrder = 171
            string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced"]
        }

        def Shader "ConstantColor3"
        {
            uniform token info:id = "ND_constant_color3"
            color3f inputs:value = (0, 0.9914394, 1) (
                colorSpace = "srgb_texture"
            )
            color3f outputs:out
            float2 ui:nodegraph:node:pos = (152.1914, 44.679688)
            int ui:nodegraph:node:stackingOrder = 165
        }

        def Shader "Time"
        {
            uniform token info:id = "ND_time_float"
            float outputs:out
            float2 ui:nodegraph:node:pos = (-215.3164, 151.63672)
            int ui:nodegraph:node:stackingOrder = 165
        }

        def Shader "Sin"
        {
            uniform token info:id = "ND_sin_float"
            float inputs:in.connect = </Root/Hologram/Time.outputs:out>
            float outputs:out
            float2 ui:nodegraph:node:pos = (-33.85547, 150.85547)
            int ui:nodegraph:node:stackingOrder = 165
        }

        def Shader "Abs"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/Hologram/Sin.outputs:out>
            float outputs:out
            float2 ui:nodegraph:node:pos = (138.4336, 149)
            int ui:nodegraph:node:stackingOrder = 165
        }

        def Shader "Multiply"
        {
            uniform token info:id = "ND_multiply_color3FA"
            prepend color3f inputs:in1.connect = </Root/Hologram/ConstantColor3.outputs:out>
            float inputs:in2.connect = </Root/Hologram/Abs.outputs:out>
            color3f outputs:out
            float2 ui:nodegraph:node:pos = (400.28125, 142.42188)
            int ui:nodegraph:node:stackingOrder = 168
        }
    }

    def Xform "SurfacePlane" (
        active = true
    )
    {
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "Collider"
        {
            uint group = 1
            uniform token info:id = "RealityKit.Collider"
            uint mask = 4294967295
            token type = "Default"

            def RealityKitStruct "Shape"
            {
                float3 extent = (0.5, 0.02, 0.5)
                float height = 0
                float radius = 0
                token shapeType = "Box"

                def RealityKitStruct "pose"
                {
                }
            }
        }

        def RealityKitComponent "RigidBody"
        {
            bool gravityEnabled = 0
            uniform token info:id = "RealityKit.RigidBody"
            token motionType = "Static"

            def RealityKitStruct "massFrame"
            {
                def RealityKitStruct "m_pose"
                {
                }
            }

            def RealityKitStruct "material"
            {
            }
        }
    }

    def Xform "SensorContainer" (
        active = true
    )
    {
        reorder nameChildren = ["SensorNode", "MascotNode"]
        def Xform "SensorNode" (
            active = true
        )
        {
            reorder nameChildren = ["sensor", "Transmitter"]
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            def "sensor" (
                active = true
                customData = {
                    float3 rotationEulerHint = (3.1415927, 0, 3.1415927)
                }
                references = @sensor.usdz@
            )
            {
                quatf xformOp:orient = (1.9106855e-15, -4.371139e-8, 1, -4.371139e-8)
                float3 xformOp:scale = (0.01, 0.01, 0.01)
                float3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def RealityKitComponent "SpatialAudio"
            {
                uniform token info:id = "RealityKit.SpatialAudio"
            }
        }

        def Xform "MascotNode" (
            active = true
        )
        {
            reorder nameChildren = ["robot_mascot", "TextAnchor"]
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            def "robot_mascot" (
                active = true
                customData = {
                    float3 rotationEulerHint = (-1.5707963, 0, 0)
                }
                references = @robot_mascot.usdz@
            )
            {
                quatf xformOp:orient = (0.70710677, -0.7071067, 0, 0)
                float3 xformOp:scale = (0.5, 0.5, 0.5)
                float3 xformOp:translate = (0.2, 0.02, -0.5)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Xform "TextAnchor" (
                active = true
            )
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (1, 1, 1)
                float3 xformOp:translate = (0, 1.44, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def RealityKitComponent "Billboard"
            {
                float blendFactor = 0
                uniform token info:id = "RealityKit.Billboard"
            }
        }
    }
}

